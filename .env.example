# Copy to .env and fill in for your environment. Every service falls back
# to sensible local-demo defaults if these aren't set — see each service's
# source for the exact fallback values. The three auth secrets below fall
# back to hardcoded DEMO-ONLY-INSECURE values with a loud startup warning
# — fine for local testing, never for anything reachable beyond localhost.

# --- Auth secrets — set these to real random values, and to the SAME
#     values across every service listed, or cross-service auth breaks ---

# control-plane, gateway, payout-engine — shared secret authenticating
# trusted backend services to each other (session validate/finalize,
# ledger reserve/reverse). Generate with e.g. `openssl rand -hex 32`.
INTERNAL_SERVICE_KEY=

# control-plane, payout-engine — shared secret for signing/verifying user
# login tokens (HS256). Both services verify tokens independently against
# this same value. Generate with e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# control-plane, payout-engine — the platform-operator credential for
# ops-only endpoints (KYB approve/reject, node/session listing, unfiltered
# payout listing). Unset means these endpoints are unreachable, not open.
ADMIN_API_KEY=

# control-plane — Postgres connection (see db/schema.sql)
DATABASE_URL=postgres://postgres:demo_pw_local_only@127.0.0.1:5432/bandwidth_platform?sslmode=disable

# gateway, payout-engine — where to reach the control-plane
CONTROL_PLANE_URL=http://127.0.0.1:8080

# control-plane — where to reach the fraud-scoring service (never blocks
# finalization if unreachable — see control-plane/fraud.go)
FRAUD_SERVICE_URL=http://127.0.0.1:8082

# payout-engine — real VTpass credentials. Leave unset to use the mock
# provider. VTPASS_ENV=live routes to the real production API instead of
# sandbox.vtpass.com — do not set this until you've verified the sandbox
# integration end-to-end with real (test) credentials first.
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_ENV=sandbox

